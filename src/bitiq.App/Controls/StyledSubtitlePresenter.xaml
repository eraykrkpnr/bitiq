<UserControl x:Class="Bitiq.App.Controls.StyledSubtitlePresenter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             IsHitTestVisible="False">
    <Grid x:Name="RootGrid" ClipToBounds="True">
        <Border x:Name="AnchorContainer"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SlideTransform" X="0" Y="0" />
            </Border.RenderTransform>
            <Border x:Name="OuterBox"
                    SnapsToDevicePixels="True">
                <StackPanel x:Name="ContentStack" Orientation="Vertical">
                    <StackPanel x:Name="LinesStack" Orientation="Vertical" />
                    <ContentControl x:Name="OriginalHost" Margin="0,4,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
