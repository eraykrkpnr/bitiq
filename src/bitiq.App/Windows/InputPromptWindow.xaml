<Window x:Class="Bitiq.App.Windows.InputPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400"
        Height="170"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        Foreground="#F8FAFC">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptLabel" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
        <TextBox x:Name="InputBox"
                 Height="32"
                 Padding="8,4"
                 VerticalContentAlignment="Center"
                 Background="#1E293B"
                 Foreground="#F8FAFC"
                 BorderBrush="#475569"
                 FontSize="13.5" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="İptal" Width="80" Height="30" Margin="0,0,8,0" Background="#334155" Foreground="White" BorderThickness="0" Click="Cancel_Click" />
            <Button Content="Tamam" Width="90" Height="30" Background="#0284C7" Foreground="White" BorderThickness="0" FontWeight="Bold" IsDefault="True" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
