<Window x:Class="Bitiq.App.Windows.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="bitiq"
        Width="680"
        Height="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="WelcomeHeaderText" Text="bitiq'e Hoş Geldiniz" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC" />
                <TextBlock x:Name="WelcomeDescText"
                           Text="Başlamak için hangi çeviri motorunu kullanmak istediğinizi seçin. İstediğiniz zaman ana ekrandan değiştirebilirsiniz."
                           Foreground="#94A3B8"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="2" VerticalAlignment="Top" Margin="12,2,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="WizardLangTrBtn" Content="TR" Padding="10,4" FontSize="12" FontWeight="Bold" BorderThickness="0" Background="#0284C7" Foreground="White" Cursor="Hand" Click="WizardLangTrBtn_Click" />
                    <Button x:Name="WizardLangEnBtn" Content="EN" Padding="10,4" FontSize="12" FontWeight="Bold" BorderThickness="0" Background="Transparent" Foreground="#94A3B8" Cursor="Hand" Click="WizardLangEnBtn_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Sistem Kontrolü -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="SysCheckHeaderText" Text="Sistem Hazırlık Kontrolü" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,6" />
                <TextBlock x:Name="OcrStatusText" TextWrapping="Wrap" FontSize="12.5" Foreground="#E2E8F0" />
                <TextBlock x:Name="GpuStatusText" TextWrapping="Wrap" FontSize="12.5" Foreground="#E2E8F0" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Motor Seçenekleri -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <RadioButton x:Name="LocalRadio"
                         Grid.Column="0"
                         GroupName="SetupEngine"
                         Checked="EngineChoice_Changed"
                         Padding="0"
                         HorizontalContentAlignment="Stretch"
                         VerticalContentAlignment="Stretch">
                <RadioButton.Template>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Background="#1E293B" BorderBrush="#334155" BorderThickness="2" CornerRadius="10" Padding="16" Cursor="Hand">
                            <StackPanel>
                                <TextBlock x:Name="LocalCardTitleText" Text="Yerel (TranslateGemma)" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" TextWrapping="Wrap" />
                                <TextBlock x:Name="LocalCardSubtitleText" Text="İnternetsiz, daha doğal" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,4,0,8" />
                                <TextBlock x:Name="LocalCardDescText" Text="• RTX GPU ile ultra düşük gecikme&#x0a;• İnternet bağlantısı gerekmez&#x0a;• İlk seferde ~2.9–4.7 GB indirilir (kesilirse devam eder)"
                                           Foreground="#CBD5E1"
                                           FontSize="12.5"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#38BDF8" />
                                <Setter TargetName="Card" Property="Background" Value="#172554" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </RadioButton.Template>
            </RadioButton>

            <RadioButton x:Name="GoogleRadio"
                         Grid.Column="2"
                         GroupName="SetupEngine"
                         IsChecked="True"
                         Checked="EngineChoice_Changed"
                         Padding="0"
                         HorizontalContentAlignment="Stretch"
                         VerticalContentAlignment="Stretch">
                <RadioButton.Template>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Background="#1E293B" BorderBrush="#334155" BorderThickness="2" CornerRadius="10" Padding="16" Cursor="Hand">
                            <StackPanel>
                                <TextBlock x:Name="GoogleCardTitleText" Text="Google Translate" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" TextWrapping="Wrap" />
                                <TextBlock x:Name="GoogleCardSubtitleText" Text="Hafif ve hızlı" Foreground="#4ADE80" FontWeight="SemiBold" Margin="0,4,0,8" />
                                <TextBlock x:Name="GoogleCardDescText" Text="• Hiçbir model veya ek dosya indirilmez&#x0a;• GPU/VRAM tüketimi sıfırdır&#x0a;• Hemen kullanıma hazır (internet gerektirir)"
                                           Foreground="#CBD5E1"
                                           FontSize="12.5"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#4ADE80" />
                                <Setter TargetName="Card" Property="Background" Value="#064E3B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </RadioButton.Template>
            </RadioButton>
        </Grid>

        <!-- İndirme İlerlemesi ve Model Kalitesi -->
        <StackPanel Grid.Row="3" Margin="0,0,0,14">
            <StackPanel x:Name="QuantPanel" Visibility="Collapsed" Margin="0,0,0,12">
                <TextBlock x:Name="QuantLabelText" Text="Yerel Model Kalitesi:" FontSize="12.5" Foreground="#94A3B8" Margin="0,0,0,4" />
                <ComboBox x:Name="QuantCombo" Height="30">
                    <ComboBoxItem x:Name="QuantQ8Item" Content="Q8_0 (~3.85 GB — En Yüksek Kalite, Varsayılan)" Tag="Q8_0" IsSelected="True" />
                    <ComboBoxItem x:Name="QuantQ4Item" Content="Q4_K_M (~2.32 GB — Daha Hızlı ve Hafif)" Tag="Q4_K_M" />
                </ComboBox>
            </StackPanel>
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
                <TextBlock x:Name="DownloadStatusText" Text="Hazırlanıyor…" Foreground="#E2E8F0" FontSize="12.5" Margin="0,0,0,6" />
                <ProgressBar x:Name="DownloadBar" Height="16" Minimum="0" Maximum="100" Value="0" Foreground="#38BDF8" Background="#1E293B" />
                <TextBlock x:Name="DownloadDetailText" Text="" Foreground="#94A3B8" FontSize="11.5" Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Alt Düğmeler -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelBtn"
                    Content="İptal"
                    Padding="16,9"
                    Margin="0,0,10,0"
                    Background="#334155"
                    Foreground="#F8FAFC"
                    BorderThickness="0"
                    Visibility="Collapsed"
                    Click="CancelDownload_Click" />
            <Button x:Name="StartBtn"
                    Content="Devam Et ve Başla"
                    Padding="22,10"
                    FontWeight="Bold"
                    FontSize="14"
                    Background="#0284C7"
                    Foreground="White"
                    BorderThickness="0"
                    Click="Continue_Click" />
        </StackPanel>
    </Grid>
</Window>
