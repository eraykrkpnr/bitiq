<Window x:Class="Bitiq.App.Windows.SubtitleOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Bitiq.App.Controls"
        Title="bitiq"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid>
        <controls:StyledSubtitlePresenter x:Name="SubtitlePresenter" />

        <!-- Konumlandır modunda görünür sürükleme/boyutlandırma çerçevesi -->
        <Border x:Name="EditBorder"
                Visibility="Collapsed"
                BorderBrush="#38BDF8"
                BorderThickness="2"
                CornerRadius="8"
                Background="#220F172A">
            <Grid>
                <Border Background="#CC0F172A"
                        CornerRadius="6"
                        Padding="10,4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,8,0,0"
                        MouseLeftButtonDown="HeaderDrag_MouseLeftButtonDown"
                        Cursor="SizeAll">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Altyazı Alanını Konumlandır (Sürükle / Köşeden Boyutlandır)"
                                   Foreground="#E2E8F0"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Content="Tamam"
                                Margin="10,0,0,0"
                                Padding="8,2"
                                Background="#0284C7"
                                Foreground="White"
                                BorderThickness="0"
                                Click="DonePositioning_Click" />
                    </StackPanel>
                </Border>
                <Thumb x:Name="ResizeThumb"
                       Width="20"
                       Height="20"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Cursor="SizeNWSE"
                       DragDelta="ResizeThumb_DragDelta">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="#38BDF8" CornerRadius="3" Margin="2" />
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </Border>
    </Grid>
</Window>
