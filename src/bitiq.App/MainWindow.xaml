<Window x:Class="Bitiq.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Bitiq.App.Controls"
        Title="bitiq"
        Width="960"
        Height="740"
        MinWidth="820"
        MinHeight="620"
        Background="#0B0F19"
        Foreground="#F8FAFC"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Üst Durum Çubuğu -->
        <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#94A3B8" Margin="0,0,8,0" />
                        <TextBlock x:Name="StatusTitleText" Text="Hazır" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" />
                    </StackPanel>
                    <TextBlock x:Name="StatusDetailText"
                               Text="Başlatmak için 'Çevrilecek Alanı Seç' ardından 'Başlat'a basın."
                               Foreground="#94A3B8"
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               Margin="18,3,0,0" />
                </StackPanel>

                <StackPanel x:Name="InlineDownloadPanel" Grid.Column="1" Width="260" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="InlineDownloadText" Text="İndiriliyor…" FontSize="11.5" Foreground="#38BDF8" Margin="0,0,0,4" />
                    <ProgressBar x:Name="InlineDownloadBar" Height="10" Minimum="0" Maximum="100" Value="0" Foreground="#38BDF8" Background="#1E293B" />
                </StackPanel>

                <!-- Arayüz Dili Toggle (TR | EN) -->
                <Border Grid.Column="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="UiLangTrBtn"
                                Content="TR"
                                Width="38"
                                Height="28"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#F8FAFC"
                                Background="#0284C7"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="UiLangTrBtn_Click" />
                        <Button x:Name="UiLangEnBtn"
                                Content="EN"
                                Width="38"
                                Height="28"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#94A3B8"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="UiLangEnBtn_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Uyarı Bantları -->
        <StackPanel Grid.Row="1">
            <Border x:Name="OcrWarningBanner" Visibility="Collapsed" Background="#451A03" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                <TextBlock x:Name="OcrWarningText" Foreground="#FDE68A" FontSize="12.5" TextWrapping="Wrap" />
            </Border>
            <Border x:Name="DriverWarningBanner" Visibility="Collapsed" Background="#451A03" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                <TextBlock x:Name="DriverWarningText" Foreground="#FDE68A" FontSize="12.5" TextWrapping="Wrap" />
            </Border>
            <Border x:Name="VramWarningBanner" Visibility="Collapsed" Background="#451A03" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                <TextBlock x:Name="VramWarningText" Foreground="#FDE68A" FontSize="12.5" TextWrapping="Wrap" />
            </Border>
            <Border x:Name="OverlapWarningBanner" Visibility="Collapsed" Background="#450A0A" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                <TextBlock x:Name="OverlapWarningText"
                           Text="⚠ Uyarı: Altyazı penceresi OCR yakalama bölgesiyle çakışıyor! Uygulamanın kendi çevirisini okumaması için altyazı katmanını 'Konumlandır' ile taşıyın veya başka bir bölge seçin."
                           Foreground="#FECACA" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- Ana Eylem Düğmeleri -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,12">
            <Button x:Name="StartStopBtn"
                    Content="▶  Başlat"
                    Height="44"
                    Padding="24,0"
                    Margin="0,0,10,6"
                    FontSize="15"
                    FontWeight="Bold"
                    Background="#0284C7"
                    Foreground="White"
                    BorderThickness="0"
                    Click="StartStopBtn_Click" />
            <Button x:Name="SelectRegionBtn"
                    Content="🎯  Çevrilecek Alanı Seç"
                    Height="44"
                    Padding="18,0"
                    Margin="0,0,10,6"
                    FontSize="13.5"
                    FontWeight="SemiBold"
                    Background="#1E293B"
                    Foreground="#F8FAFC"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    Click="SelectRegionBtn_Click" />
            <ToggleButton x:Name="ToggleScreenOverlayBtn"
                          Height="44"
                          Padding="15,0"
                          Margin="0,0,10,6"
                          FontSize="13.5"
                          FontWeight="SemiBold"
                          Cursor="Hand"
                          Click="ToggleScreenOverlayBtn_Click">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="BtnBorder"
                                Background="#064E3B"
                                BorderBrush="#10B981"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Presenter"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="#F8FAFC" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#1E293B" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#475569" />
                                <Setter TargetName="Presenter" Property="TextElement.Foreground" Value="#CBD5E1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#38BDF8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
                👁  Ekran Altyazısı: Açık
            </ToggleButton>
            <ToggleButton x:Name="PositionOverlayBtn"
                          Content="✥  Altyazıyı Konumlandır"
                          Height="44"
                          Padding="16,0"
                          Margin="0,0,10,6"
                          FontSize="13.5"
                          FontWeight="SemiBold"
                          Background="#1E293B"
                          Foreground="#F8FAFC"
                          BorderBrush="#334155"
                          BorderThickness="1"
                          Click="PositionOverlayBtn_Click" />
            <Button x:Name="OpenTestWindowBtn"
                    Content="🎬  Test Penceresi Aç"
                    Height="44"
                    Padding="16,0"
                    Margin="0,0,0,6"
                    FontSize="13.5"
                    FontWeight="SemiBold"
                    Background="#1E293B"
                    Foreground="#E2E8F0"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    Click="OpenTestWindowBtn_Click" />
        </WrapPanel>

        <!-- Sekmeler -->
        <TabControl x:Name="MainTabs" Grid.Row="3" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" Padding="14" SelectionChanged="MainTabs_SelectionChanged">
            <!-- SEKME 1: ANA EKRAN -->
            <TabItem x:Name="MainTabGeneral" Header="Genel">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="EngineSelectorHeaderText" Text="Çeviri Motoru Seçimi" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,10" />
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <RadioButton x:Name="EngineLocalRadio"
                                         Grid.Column="0"
                                         GroupName="MainEngine"
                                         Click="EngineCard_Click"
                                         HorizontalContentAlignment="Stretch"
                                         VerticalContentAlignment="Stretch">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Card" Background="#1E293B" BorderBrush="#334155" BorderThickness="2" CornerRadius="10" Padding="14" Cursor="Hand">
                                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="#38BDF8" />
                                                <Setter TargetName="Card" Property="Background" Value="#172554" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                                <StackPanel>
                                    <TextBlock x:Name="EngineLocalTitleText" Text="Yerel AI (Hy-MT2 7B Q6_K / TranslateGemma): internetsiz, bağlamlı" FontSize="14.5" FontWeight="Bold" Foreground="#F8FAFC" TextWrapping="Wrap" />
                                    <TextBlock x:Name="EngineLocalDescText" Text="RTX GPU üzerinde çalışır. Hy-MT2 7B Q6_K önceki replikleri ve oyun profilini bağlam olarak kullanır."
                                               Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="EngineGoogleRadio"
                                         Grid.Column="2"
                                         GroupName="MainEngine"
                                         Click="EngineCard_Click"
                                         HorizontalContentAlignment="Stretch"
                                         VerticalContentAlignment="Stretch">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Card" Background="#1E293B" BorderBrush="#334155" BorderThickness="2" CornerRadius="10" Padding="14" Cursor="Hand">
                                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="#4ADE80" />
                                                <Setter TargetName="Card" Property="Background" Value="#064E3B" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                                <StackPanel>
                                    <TextBlock x:Name="EngineGoogleTitleText" Text="Google Translate: hafif ve hızlı" FontSize="14.5" FontWeight="Bold" Foreground="#F8FAFC" TextWrapping="Wrap" />
                                    <TextBlock x:Name="EngineGoogleDescText" Text="Ekran kartı ve bellek kullanmaz. Seçildiğinde yerel model VRAM/RAM'den tamamen boşaltılır."
                                               Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </RadioButton>
                        </Grid>

                        <!-- Dil Ayarları (Ekrandaki Dil -> Çeviri Dili) -->
                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="LangSettingsHeaderText" Text="🌐 Dil Ayarları (Ekrandaki Dil → Çeviri Dili)" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="4" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="SourceLangLabelText" Grid.Row="0" Grid.Column="0" Text="Ekrandaki Dil (OCR):" FontSize="12" Foreground="#94A3B8" />
                                    <TextBlock x:Name="TargetLangLabelText" Grid.Row="0" Grid.Column="2" Text="Çevrilecek Dil (Altyazı):" FontSize="12" Foreground="#94A3B8" />

                                    <ComboBox x:Name="SourceLangCombo"
                                              Grid.Row="2"
                                              Grid.Column="0"
                                              Height="36"
                                              HorizontalContentAlignment="Stretch"
                                              SelectionChanged="SourceLangCombo_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid HorizontalAlignment="Stretch">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding DisplayName}"
                                                               Foreground="{Binding NameBrush}"
                                                               FontWeight="{Binding NameWeight}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding StatusText}"
                                                               Foreground="{Binding StatusBrush}"
                                                               FontSize="11.5"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,6,0" />
                                                    <Button Grid.Column="2"
                                                            Content="{Binding DownloadButtonText}"
                                                            Tag="{Binding Code}"
                                                            Visibility="{Binding DownloadButtonVisibility}"
                                                            Height="22"
                                                            Padding="8,0"
                                                            FontSize="11"
                                                            FontWeight="Bold"
                                                            Background="#0284C7"
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            ToolTip="{Binding DownloadTooltip}"
                                                            Click="InstallOcrLangBtn_Click" />
                                                </Grid>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <Button x:Name="SwapLangsBtn"
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Content="⇄"
                                            Width="38"
                                            Height="36"
                                            Margin="8,0"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Background="#1E293B"
                                            Foreground="#38BDF8"
                                            BorderBrush="#334155"
                                            BorderThickness="1"
                                            Cursor="Hand"
                                            ToolTip="Dilleri değiştir"
                                            Click="SwapLangsBtn_Click" />

                                    <ComboBox x:Name="TargetLangCombo"
                                              Grid.Row="2"
                                              Grid.Column="2"
                                              Height="36"
                                              SelectionChanged="TargetLangCombo_SelectionChanged" />
                                </Grid>

                                <TextBlock x:Name="SourceOcrPackInfoText"
                                           Text="Kurulu OCR dilleri doğrudan seçilebilir. Yanında '⬇ İndir' görünen diller Windows OCR paketi kurulduktan sonra aktif olur."
                                           Foreground="#94A3B8"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                                <StackPanel x:Name="QuickInstallOcrPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,8,0,0">
                                    <TextBlock x:Name="QuickInstallOcrText" Foreground="#FDE68A" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Button x:Name="QuickInstallOcrBtn"
                                            Content="⬇ OCR Paketini İndir ve Kur"
                                            Height="28"
                                            Padding="12,0"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Background="#0284C7"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="InstallOcrLangBtn_Click" />
                                </StackPanel>
                                <ProgressBar x:Name="OcrInstallProgressBar"
                                             Height="6"
                                             IsIndeterminate="True"
                                             Visibility="Collapsed"
                                             Foreground="#38BDF8"
                                             Background="#1E293B"
                                             Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="CaptureSourceHeaderText" Text="🎯 Yakalama Kaynağı (Ekran veya Pencereye Kilitle)" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CaptureTargetCombo"
                                              Grid.Column="0"
                                              Height="34"
                                              DropDownOpened="CaptureTargetCombo_DropDownOpened"
                                              SelectionChanged="CaptureTargetCombo_SelectionChanged" />
                                    <Button x:Name="RefreshWindowsBtn"
                                            Grid.Column="2"
                                            Content="🔄 Yenile"
                                            Height="34"
                                            Padding="14,0"
                                            Background="#1E293B"
                                            Foreground="#E2E8F0"
                                            BorderBrush="#334155"
                                            BorderThickness="1"
                                            Click="RefreshWindowsBtn_Click" />
                                </Grid>
                                <TextBlock x:Name="CaptureSourceHintText"
                                           Text="💡 İpucu: Bir pencere seçip 'Çevrilecek Alanı Seç' derseniz yakalama ve çeviri o pencereye kilitlenir. Üstüne başka bir pencere veya altyazı kutusu gelse bile yalnızca seçilen pencere yakalanır."
                                           Foreground="#94A3B8"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="RegionSummaryHeaderText" Text="Seçili Yakalama Bölgesi (İngilizce → Türkçe)" FontWeight="SemiBold" Foreground="#38BDF8" />
                                <TextBlock x:Name="RegionSummaryText" Text="Henüz seçilmedi." Foreground="#E2E8F0" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ContextCardHeaderText" Grid.Column="0" Text="🧠 Bağlam (Context) ve Oyun Profili" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ContextMemoryBadgeText" Grid.Column="1" Text="Bellekte: 0/8 replik" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" />
                                </Grid>
                                <CheckBox x:Name="ContextEnabledCheck"
                                          Content="Bağlam duyarlı çeviriyi etkinleştir (önceki replikler + oyun sözlüğü, Hy-MT2 7B Q6_K)"
                                          Margin="0,0,0,8"
                                          Checked="ContextEnabledCheck_Changed"
                                          Unchecked="ContextEnabledCheck_Changed" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ActiveGameProfileCombo"
                                              Grid.Column="0"
                                              Height="32"
                                              SelectionChanged="ActiveGameProfileCombo_SelectionChanged" />
                                    <Button x:Name="EditGameProfileBtn"
                                            Grid.Column="2"
                                            Content="⚙ Profili Düzenle"
                                            Height="32"
                                            Padding="12,0"
                                            Background="#1E293B"
                                            Foreground="#E2E8F0"
                                            BorderBrush="#334155"
                                            BorderThickness="1"
                                            Click="EditGameProfileBtn_Click" />
                                    <Button x:Name="ResetContextBtn"
                                            Grid.Column="4"
                                            Content="🔄 Bağlamı Sıfırla"
                                            Height="32"
                                            Padding="12,0"
                                            Background="#1E293B"
                                            Foreground="#38BDF8"
                                            BorderBrush="#334155"
                                            BorderThickness="1"
                                            Click="ResetContextBtn_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <CheckBox x:Name="ShowScreenOverlayMainCheck"
                                          Content="Ekranda şeffaf altyazı kutusunu göster (kapatılırsa yalnızca OBS kaynağına gönderilir)"
                                          Margin="0,0,0,8"
                                          Checked="ScreenOverlayToggle_Changed"
                                          Unchecked="ScreenOverlayToggle_Changed" />
                                <CheckBox x:Name="MergeIncompleteCheck"
                                          Content="Bitmemiş cümleleri birleştirerek çevir (nokta ile bitmeyen altyazılara sonraki satırı ekle)"
                                          Margin="0,0,0,8"
                                          Checked="MergeIncompleteCheck_Changed"
                                          Unchecked="MergeIncompleteCheck_Changed" />
                                <CheckBox x:Name="StreamingMainCheck"
                                          Content="Yazıyı daktilo (typewriter) efektiyle akışlı göster (kapatılırsa cümle tek seferde anında görünür)"
                                          Checked="StreamingCheck_Changed"
                                          Unchecked="StreamingCheck_Changed" />
                            </StackPanel>
                        </Border>

                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock x:Name="LivePanelHeaderText" Text="Canlı Algılanan &amp; Çevrilen Metin" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,8" />
                                <TextBlock x:Name="LiveSourceLabelText" Text="İngilizce (OCR):" FontSize="11.5" Foreground="#94A3B8" />
                                <TextBlock x:Name="LiveEnglishText" Text="—" FontSize="14" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,2,0,10" />
                                <TextBlock x:Name="LiveTargetLabelText" Text="Türkçe (Çeviri):" FontSize="11.5" Foreground="#94A3B8" />
                                <TextBlock x:Name="LiveTurkishText" Text="—" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- SEKME 2: OYUN PROFİLİ (BAĞLAM & SÖZLÜK) -->
            <TabItem x:Name="MainTabProfiles" Header="Oyun Profili">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border x:Name="ProfileModelNoticeBanner" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                            <TextBlock x:Name="ProfileModelNoticeText"
                                       Text="ℹ Oyun profili ve diyalog geçmişi Hy-MT2 7B (Q6_K) seçiliyken otomatik olarak modele bağlam olarak iletilir."
                                       Foreground="#94A3B8"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ProfileEditSelectLabelText" Text="Profil:" VerticalAlignment="Center" Foreground="#CBD5E1" FontWeight="SemiBold" Margin="0,0,8,4" />
                                <ComboBox x:Name="GameProfileEditCombo" Width="210" Height="30" Margin="0,0,8,4" SelectionChanged="GameProfileEditCombo_SelectionChanged" />
                                <Button x:Name="NewGameProfileBtn" Content="+ Yeni" Padding="10,5" Margin="0,0,6,4" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1" Click="NewGameProfile_Click" />
                                <Button x:Name="SaveGameProfileBtn" Content="Kaydet" Padding="12,5" Margin="0,0,6,4" Background="#0284C7" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="SaveGameProfile_Click" />
                                <Button x:Name="DeleteGameProfileBtn" Content="Sil" Padding="10,5" Margin="0,0,10,4" Background="#7F1D1D" Foreground="White" BorderThickness="0" Click="DeleteGameProfile_Click" />
                                <Button x:Name="ExportGameProfileBtn" Content="JSON Dışa Aktar" Padding="10,5" Margin="0,0,6,4" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1" Click="ExportGameProfile_Click" />
                                <Button x:Name="ImportGameProfileBtn" Content="JSON İçe Aktar" Padding="10,5" Margin="0,0,0,4" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1" Click="ImportGameProfile_Click" />
                            </WrapPanel>
                        </Border>

                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="ProfileMetaHeaderText" Text="Oyun Bilgileri ve Üslup" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="1.4*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="GameTitleLabelText" Text="Oyun Adı" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4" />
                                        <TextBox x:Name="GameTitleBox" Height="30" Padding="8,0" VerticalContentAlignment="Center" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" TextChanged="ProfileField_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="GameSynopsisLabelText" Text="Kısa Özet / Tür (1-2 cümle)" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4" />
                                        <TextBox x:Name="GameSynopsisBox" Height="30" Padding="8,0" VerticalContentAlignment="Center" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" TextChanged="ProfileField_TextChanged" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="GameToneLabelText" Text="Üslup ve Hitap Notu (ör. 'Doğal konuşma dili; yakın arkadaşlar sen diye hitap eder')" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4" />
                                <TextBox x:Name="GameToneBox" Height="30" Padding="8,0" VerticalContentAlignment="Center" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" TextChanged="ProfileField_TextChanged" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Karakterler -->
                            <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock x:Name="CharactersHeaderText" Text="Karakterler (Ad / Cinsiyet-Rol)" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="AddCharacterBtn" Content="+ Ekle" Padding="8,3" Margin="0,0,6,0" Background="#1E293B" Foreground="#4ADE80" BorderBrush="#334155" BorderThickness="1" Click="AddCharacterRow_Click" />
                                            <Button x:Name="RemoveCharacterBtn" Content="Sil" Padding="8,3" Background="#7F1D1D" Foreground="White" BorderThickness="0" Click="RemoveCharacterRow_Click" />
                                        </StackPanel>
                                    </Grid>
                                    <DataGrid x:Name="CharactersGrid"
                                              Height="165"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              Background="#0B0F19"
                                              Foreground="#E2E8F0"
                                              RowBackground="#111827"
                                              AlternatingRowBackground="#1E293B"
                                              GridLinesVisibility="Horizontal"
                                              HeadersVisibility="Column"
                                              BorderBrush="#334155"
                                              CellEditEnding="ProfileGrid_CellEditEnding">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn x:Name="ColCharName" Header="Ad" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="0.9*" />
                                            <DataGridTextColumn x:Name="ColCharNote" Header="Not (cinsiyet/rol)" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="1.2*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- Sözlük / Terimler -->
                            <Border Grid.Column="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock x:Name="GlossaryHeaderText" Text="Sözlük / Terimler (X → Y)" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="AddGlossaryBtn" Content="+ Ekle" Padding="8,3" Margin="0,0,6,0" Background="#1E293B" Foreground="#4ADE80" BorderBrush="#334155" BorderThickness="1" Click="AddGlossaryRow_Click" />
                                            <Button x:Name="RemoveGlossaryBtn" Content="Sil" Padding="8,3" Background="#7F1D1D" Foreground="White" BorderThickness="0" Click="RemoveGlossaryRow_Click" />
                                        </StackPanel>
                                    </Grid>
                                    <DataGrid x:Name="GlossaryGrid"
                                              Height="165"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              Background="#0B0F19"
                                              Foreground="#E2E8F0"
                                              RowBackground="#111827"
                                              AlternatingRowBackground="#1E293B"
                                              GridLinesVisibility="Horizontal"
                                              HeadersVisibility="Column"
                                              BorderBrush="#334155"
                                              CellEditEnding="ProfileGrid_CellEditEnding">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn x:Name="ColGlossarySrc" Header="Kaynak Terim" Binding="{Binding Source, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                            <DataGridTextColumn x:Name="ColGlossaryTgt" Header="Türkçe / Hedef" Binding="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Expander x:Name="ProfilePreviewExpander"
                                  Header="Hy-MT2 Prompt Bağlam Önizlemesi ([Background Information])"
                                  Foreground="#F8FAFC"
                                  FontWeight="SemiBold"
                                  Background="#0F172A"
                                  BorderBrush="#1E293B"
                                  BorderThickness="1"
                                  Padding="10">
                            <TextBox x:Name="ProfilePromptPreviewBox"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="90"
                                     Margin="0,8,0,0"
                                     Padding="8"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Background="#0B0F19"
                                     Foreground="#CBD5E1"
                                     BorderBrush="#334155" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- SEKME 3: GÖRÜNÜM (STİL SİSTEMİ) -->
            <TabItem x:Name="MainTabStyle" Header="Görünüm">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Canlı Önizleme -->
                        <Border Height="175" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,12" ClipToBounds="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1E293B" Offset="0" />
                                    <GradientStop Color="#0F172A" Offset="0.5" />
                                    <GradientStop Color="#172554" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <TextBlock x:Name="StyleLivePreviewLabel" Text="CANLI ÖNİZLEME" Foreground="#475569" FontSize="11" FontWeight="Bold" Margin="10,8" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <controls:StyledSubtitlePresenter x:Name="StylePreviewPresenter" />
                            </Grid>
                        </Border>

                        <!-- Hazır Stiller & JSON İçe/Dışa Aktar -->
                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock x:Name="PresetLabelText" Text="Hazır Stil:" VerticalAlignment="Center" Foreground="#CBD5E1" FontWeight="SemiBold" Margin="0,0,8,4" />
                                <ComboBox x:Name="ProfileCombo" Width="210" Height="30" Margin="0,0,8,4" SelectionChanged="ProfileCombo_SelectionChanged" />
                                <Button x:Name="SaveProfileBtn" Content="Kaydet" Padding="10,5" Margin="0,0,6,4" Background="#0284C7" Foreground="White" BorderThickness="0" Click="SaveProfile_Click" />
                                <Button x:Name="SaveAsProfileBtn" Content="Farklı Kaydet" Padding="10,5" Margin="0,0,6,4" Background="#334155" Foreground="White" BorderThickness="0" Click="SaveAsProfile_Click" />
                                <Button x:Name="RenameProfileBtn" Content="Yeniden Adlandır" Padding="10,5" Margin="0,0,6,4" Background="#334155" Foreground="White" BorderThickness="0" Click="RenameProfile_Click" />
                                <Button x:Name="DeleteProfileBtn" Content="Sil" Padding="10,5" Margin="0,0,10,4" Background="#7F1D1D" Foreground="White" BorderThickness="0" Click="DeleteProfile_Click" />
                                <Button x:Name="ExportJsonBtn" Content="JSON Dışa Aktar" Padding="10,5" Margin="0,0,6,4" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1" Click="ExportStyleJson_Click" />
                                <Button x:Name="ImportJsonBtn" Content="JSON İçe Aktar" Padding="10,5" Margin="0,0,0,4" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1" Click="ImportStyleJson_Click" />
                            </WrapPanel>
                        </Border>

                        <!-- Üstte 6 Temel Ayar -->
                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="BasicStyleHeaderText" Text="Temel Stil Ayarları (Anında Yansır)" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 1. Yazı Tipi (Aranabilir) -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock x:Name="FontFamilyLabelText" Text="1. Yazı Tipi (Ara ve Seç)" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="FontSearchBox" Height="28" Padding="6,0" VerticalContentAlignment="Center" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" ToolTip="Yazı tipi ara" TextChanged="FontSearchBox_TextChanged" />
                                            <ComboBox x:Name="FontFamilyCombo" Grid.Column="2" Height="28" SelectionChanged="StyleInput_Changed" />
                                        </Grid>
                                    </StackPanel>

                                    <!-- 2. Yazı Boyutu -->
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock x:Name="FontSizeLabel" Text="2. Yazı Boyutu: 36 px" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4" />
                                        <Slider x:Name="FontSizeSlider" Minimum="16" Maximum="84" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="StyleInput_Changed" />
                                    </StackPanel>

                                    <!-- 3. Yazı Rengi -->
                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock x:Name="TextColorLabelText" Text="3. Yazı Rengi" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4" />
                                        <controls:ColorFieldControl x:Name="TextColorPicker" ColorChanged="StyleColor_Changed" />
                                    </StackPanel>

                                    <!-- 4. Arka Plan Rengi -->
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock x:Name="BgColorLabelText" Text="4. Arka Plan Rengi" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4" />
                                        <controls:ColorFieldControl x:Name="BgColorPicker" ColorChanged="StyleColor_Changed" />
                                    </StackPanel>

                                    <!-- 5. Arka Plan Opaklığı -->
                                    <StackPanel Grid.Row="4" Grid.Column="0">
                                        <TextBlock x:Name="BgOpacityLabel" Text="5. Arka Plan Opaklığı: %78" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4" />
                                        <Slider x:Name="BgOpacitySlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="StyleInput_Changed" />
                                    </StackPanel>

                                    <!-- 6. Konum -->
                                    <StackPanel Grid.Row="4" Grid.Column="2">
                                        <TextBlock x:Name="PositionLabelText" Text="6. Konum" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4" />
                                        <ComboBox x:Name="PositionPresetCombo" Height="28" SelectionChanged="StyleInput_Changed">
                                            <ComboBoxItem Content="Alt Orta" Tag="BottomCenter" />
                                            <ComboBoxItem Content="Üst Orta" Tag="TopCenter" />
                                            <ComboBoxItem Content="Orta" Tag="Center" />
                                            <ComboBoxItem Content="Alt Sol" Tag="BottomLeft" />
                                            <ComboBoxItem Content="Alt Sağ" Tag="BottomRight" />
                                            <ComboBoxItem Content="Üst Sol" Tag="TopLeft" />
                                            <ComboBoxItem Content="Üst Sağ" Tag="TopRight" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Açılır Gelişmiş Stil -->
                        <Expander x:Name="AdvancedStyleExpander"
                                  Header="Gelişmiş Stil (Kontur, Gölge, Arka Plan Modu, Yerleşim, Davranış, Orijinal Metin)"
                                  Foreground="#F8FAFC"
                                  FontWeight="SemiBold"
                                  Background="#0F172A"
                                  BorderBrush="#1E293B"
                                  BorderThickness="1"
                                  Padding="12">
                            <StackPanel Margin="0,10,0,0">
                                <!-- Yazı Ayrıntıları -->
                                <TextBlock x:Name="StyleFontDetailsHeaderText" Text="Yazı Ayrıntıları" Foreground="#38BDF8" FontWeight="Bold" Margin="0,0,0,8" />
                                <WrapPanel Margin="0,0,0,12">
                                    <StackPanel Width="150" Margin="0,0,14,8">
                                        <TextBlock x:Name="FontWeightLabelText" Text="Kalınlık" FontSize="12" Foreground="#94A3B8" />
                                        <ComboBox x:Name="FontWeightCombo" Height="28" SelectionChanged="StyleInput_Changed">
                                            <ComboBoxItem Content="İnce (300)" Tag="300" />
                                            <ComboBoxItem Content="Normal (400)" Tag="400" />
                                            <ComboBoxItem Content="Orta (500)" Tag="500" />
                                            <ComboBoxItem Content="Yarı Kalın (600)" Tag="600" />
                                            <ComboBoxItem Content="Kalın (700)" Tag="700" />
                                            <ComboBoxItem Content="Çok Kalın (800)" Tag="800" />
                                            <ComboBoxItem Content="Siyah (900)" Tag="900" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Width="140" Margin="0,0,14,8">
                                        <TextBlock x:Name="TextAlignLabelText" Text="Hizalama" FontSize="12" Foreground="#94A3B8" />
                                        <ComboBox x:Name="TextAlignCombo" Height="28" SelectionChanged="StyleInput_Changed">
                                            <ComboBoxItem Content="Orta" Tag="Center" />
                                            <ComboBoxItem Content="Sol" Tag="Left" />
                                            <ComboBoxItem Content="Sağ" Tag="Right" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Width="145" Margin="0,0,14,8">
                                        <TextBlock x:Name="LetterSpacingLabel" Text="Harf Aralığı: 0 px" FontSize="12" Foreground="#94A3B8" />
                                        <Slider x:Name="LetterSpacingSlider" Minimum="-2" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="StyleInput_Changed" />
                                    </StackPanel>
                                    <StackPanel Width="145" Margin="0,0,14,8">
                                        <TextBlock x:Name="LineHeightLabel" Text="Satır Aralığı: 1.25" FontSize="12" Foreground="#94A3B8" />
                                        <Slider x:Name="LineHeightSlider" Minimum="0.9" Maximum="2.0" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="StyleInput_Changed" />
                                    </StackPanel>
                                    <CheckBox x:Name="ItalicCheck" Content="İtalik" VerticalAlignment="Bottom" Margin="0,0,14,12" Checked="StyleCheck_Changed" Unchecked="StyleCheck_Changed" />
                                    <CheckBox x:Name="UppercaseCheck" Content="BÜYÜK HARF" VerticalAlignment="Bottom" Margin="0,0,0,12" Checked="StyleCheck_Changed" Unchecked="StyleCheck_Changed" />
                                </WrapPanel>

                                <!-- Renk, Kontur & Gölge -->
                                <TextBlock x:Name="StyleColorOutlineHeaderText" Text="Renk, Kontur ve Gölge" Foreground="#38BDF8" FontWeight="Bold" Margin="0,0,0,8" />
                                <WrapPanel Margin="0,0,0,12">
                                    <StackPanel Width="150" Margin="0,0,14,8">
                                        <TextBlock x:Name="TextOpacityLabel" Text="Yazı Opaklığı: %100" FontSize="12" Foreground="#94A3B8" />
                                        <Slider x:Name="TextOpacitySlider" Minimum="10" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="StyleInput_Changed" />
                                    </StackPanel>
                                    <StackPanel Width="140" Margin="0,0,14,8">
                                        <TextBlock x:Name="OutlineColorLabelText" Text="Kontur Rengi" FontSize="12" Foreground="#94A3B8" />
                                        <controls:ColorFieldControl x:Name="OutlineColorPicker" ColorChanged="StyleColor_Changed" />
                                    </StackPanel>
                                    <StackPanel Width="145" Margin="0,0,14,8">
                                        <TextBlock x:Name="OutlineThickLabel" Text="Kontur Kalınlığı: 2 px" FontSize="12" Foreground="#94A3B8" />
                                        <Slider x:Name="OutlineThickSlider" Minimum="0" Maximum="8" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="StyleInput_Changed" />
                                    </StackPanel>
                                    <StackPanel Width="140" Margin="0,0,14,8">
                                        <TextBlock x:Name="ShadowColorLabelText" Text="Gölge Rengi" FontSize="12" Foreground="#94A3B8" />
                                        <controls:ColorFieldControl x:Name="ShadowColorPicker" ColorChanged="StyleColor_Changed" />
                                    </StackPanel>
                                    <StackPanel Width="145" Margin="0,0,14,8">
                                        <TextBlock x:Name="ShadowOpacityLabel" Text="Gölge Opaklığı: %85" FontSize="12" Foreground="#94A3B8" />
                                        <Slider x:Name="ShadowOpacitySlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="StyleInput_Changed" />
                                    </StackPanel>
                                    <StackPanel Width="145" Margin="0,0,14,8">
                                        <TextBlock x:Name="ShadowBlurLabel" Text="Gölge Bulanıklığı: 6" FontSize="12" Foreground="#94A3B8" />
                                        <Slider x:Name="ShadowBlurSlider" Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="StyleInput_Changed" />
                                    </StackPanel>
                                    <StackPanel Width="125" Margin="0,0,14,8">
                                        <TextBlock x:Name="ShadowXLabel" Text="Gölge X: 2" FontSize="12" Foreground="#94A3B8" />
                                        <Slider x:Name="ShadowXSlider" Minimum="-10" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="StyleInput_Changed" />
                                    </StackPanel>
                                    <StackPanel Width="125" Margin="0,0,14,8">
                                        <TextBlock x:Name="ShadowYLabel" Text="Gölge Y: 2" FontSize="12" Foreground="#94A3B8" />
                                        <Slider x:Name="ShadowYSlider" Minimum="-10" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="StyleInput_Changed" />
                                    </StackPanel>
                                </WrapPanel>

                                <!-- Arka Plan & Kenarlık -->
                                <TextBlock x:Name="StyleBgBorderHeaderText" Text="Arka Plan ve Kenarlık" Foreground="#38BDF8" FontWeight="Bold" Margin="0,0,0,8" />
                                <WrapPanel Margin="0,0,0,12">
                                    <StackPanel Width="180" Margin="0,0,14,8">
                                        <TextBlock x:Name="BgModeLabelText" Text="Arka Plan Modu" FontSize="12" Foreground="#94A3B8" />
                                        <ComboBox x:Name="BgModeCombo" Height="28" SelectionChanged="StyleInput_Changed">
                                            <ComboBoxItem Content="Kapalı" Tag="None" />
                                            <ComboBoxItem Content="Satır Başına Kutu" Tag="PerLineBox" />
                                            <ComboBoxItem Content="Tek Blok" Tag="SingleBlock" />
                                            <ComboBoxItem Content="Tam Genişlik Şerit" Tag="FullWidthBar" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Width="140" Margin="0,0,14,8">
                                        <TextBlock x:Name="RadiusLabel" Text="Köşe Yuvarlaklığı: 10" FontSize="12" Foreground="#94A3B8" />
                                        <Slider x:Name="RadiusSlider" Minimum="0" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="StyleInput_Changed" />
                                    </StackPanel>
                                    <StackPanel Width="140" Margin="0,0,14,8">
                                        <TextBlock x:Name="PadHLabel" Text="Yatay İç Boşluk: 20" FontSize="12" Foreground="#94A3B8" />
                                        <Slider x:Name="PadHSlider" Minimum="0" Maximum="60" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="StyleInput_Changed" />
                                    </StackPanel>
                                    <StackPanel Width="140" Margin="0,0,14,8">
                                        <TextBlock x:Name="PadVLabel" Text="Dikey İç Boşluk: 10" FontSize="12" Foreground="#94A3B8" />
                                        <Slider x:Name="PadVSlider" Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="StyleInput_Changed" />
                                    </StackPanel>
                                    <StackPanel Width="140" Margin="0,0,14,8">
                                        <TextBlock x:Name="BorderColorLabelText" Text="Kenarlık Rengi" FontSize="12" Foreground="#94A3B8" />
                                        <controls:ColorFieldControl x:Name="BorderColorPicker" ColorChanged="StyleColor_Changed" />
                                    </StackPanel>
                                    <StackPanel Width="140" Margin="0,0,14,8">
                                        <TextBlock x:Name="BorderThickLabel" Text="Kenarlık Kalınlığı: 0" FontSize="12" Foreground="#94A3B8" />
                                        <Slider x:Name="BorderThickSlider" Minimum="0" Maximum="8" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="StyleInput_Changed" />
                                    </StackPanel>
                                </WrapPanel>

                                <!-- Yerleşim & Taşma -->
                                <TextBlock x:Name="StyleLayoutHeaderText" Text="Yerleşim ve Taşma" Foreground="#38BDF8" FontWeight="Bold" Margin="0,0,0,8" />
                                <WrapPanel Margin="0,0,0,12">
                                    <StackPanel Width="145" Margin="0,0,14,8">
                                        <TextBlock x:Name="OffsetXLabel" Text="İnce Ayar X: %0" FontSize="12" Foreground="#94A3B8" />
                                        <Slider x:Name="OffsetXSlider" Minimum="-40" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="StyleInput_Changed" />
                                    </StackPanel>
                                    <StackPanel Width="145" Margin="0,0,14,8">
                                        <TextBlock x:Name="OffsetYLabel" Text="İnce Ayar Y: %0" FontSize="12" Foreground="#94A3B8" />
                                        <Slider x:Name="OffsetYSlider" Minimum="-40" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="StyleInput_Changed" />
                                    </StackPanel>
                                    <StackPanel Width="150" Margin="0,0,14,8">
