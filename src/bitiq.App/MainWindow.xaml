                                           Foreground="#CBD5E1" FontSize="13" LineHeight="22" TextWrapping="Wrap" />
                                <TextBlock x:Name="ObsSetupTipText"
                                           Text="İpucu: Capture card gecikmesi nedeniyle görüntü altyazıdan geç geliyorsa OBS'te video yakalama kaynağınıza 'Render Delay' (İşleme Gecikmesi) filtresi ekleyebilirsiniz."
                                           Foreground="#94A3B8" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
