            <!-- SEKME 5: PERFORMANS (ANLIK CPU / RAM / GPU) -->
            <TabItem x:Name="PerformanceTab" Header="Performans">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <TextBlock x:Name="PerfNoticeText"
                                       Text="ℹ Sıfır Arka Plan Yükü: Ölçümler yalnızca bu 'Performans' sekmesi açıkken her 1.5 saniyede bir doğrudan süreç içi (in-process) Windows &amp; NVML API'lerinden okunur. Başka sekmeye geçildiğinde ölçüm zamanlayıcısı tamamen durdurulur (%0 ekstra CPU)."
                                       Foreground="#94A3B8"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- CPU Kartı -->
                            <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock x:Name="PerfCpuCardHeaderText" Text="CPU Kullanımı" FontWeight="Bold" Foreground="#38BDF8" FontSize="13.5" />
                                    <TextBlock x:Name="PerfTotalCpuText" Text="%0.0" FontSize="26" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,6,0,6" />
                                    <ProgressBar x:Name="PerfCpuBar" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="#38BDF8" Background="#1E293B" Margin="0,0,0,10" />
                                    <TextBlock x:Name="PerfAppCpuText" Text="bitiq (Arayüz + OCR): %0.0" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,3" TextWrapping="Wrap" />
                                    <TextBlock x:Name="PerfLlamaCpuText" Text="llama-server (Model): Kapalı" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- RAM Kartı -->
                            <Border Grid.Column="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock x:Name="PerfRamCardHeaderText" Text="RAM (Bellek) Kullanımı" FontWeight="Bold" Foreground="#4ADE80" FontSize="13.5" />
                                    <TextBlock x:Name="PerfTotalRamText" Text="0 MB" FontSize="26" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,6,0,6" />
                                    <ProgressBar x:Name="PerfRamBar" Height="8" Minimum="0" Maximum="8192" Value="0" Foreground="#4ADE80" Background="#1E293B" Margin="0,0,0,10" />
                                    <TextBlock x:Name="PerfAppRamText" Text="bitiq (Arayüz + OCR): 0 MB" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,3" TextWrapping="Wrap" />
                                    <TextBlock x:Name="PerfLlamaRamText" Text="llama-server (Model): Kapalı" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- GPU & VRAM Kartı -->
                            <Border Grid.Column="4" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock x:Name="PerfGpuCardHeaderText" Text="GPU &amp; VRAM Kullanımı" FontWeight="Bold" Foreground="#C084FC" FontSize="13.5" />
                                    <TextBlock x:Name="PerfGpuLoadText" Text="—" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,6,0,6" TextWrapping="Wrap" />
                                    <ProgressBar x:Name="PerfGpuBar" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="#C084FC" Background="#1E293B" Margin="0,0,0,10" />
                                    <TextBlock x:Name="PerfGpuNameText" Text="GPU: Kontrol ediliyor…" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,3" TextWrapping="Wrap" />
                                    <TextBlock x:Name="PerfVramDetailText" Text="VRAM: —" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" />
                                    <TextBlock x:Name="PerfVramSafetyText" Text="" FontSize="11.5" Foreground="#4ADE80" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="PerfLlamaStatusHeaderText" Text="Yerel Model Süreç Durumu (llama-server)" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,4" />
                                    <TextBlock x:Name="PerfEngineStatusText"
                                               Text="Durum: Kapalı (Bellek tüketmiyor)"
                                               Foreground="#CBD5E1"
                                               FontSize="12.5"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="UnloadLlamaBtn"
                                        Grid.Column="1"
                                        Content="🧹 Yerel Modeli Bellekten Boşalt"
                                        Height="36"
                                        Padding="14,0"
                                        Background="#7F1D1D"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontWeight="SemiBold"
                                        IsEnabled="False"
                                        Click="UnloadLlamaBtn_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
